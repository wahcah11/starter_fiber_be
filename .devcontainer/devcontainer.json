{
  "name": "Go Starter V2",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/app",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "terminal.integrated.defaultProfile.linux": "bash"  // ← pakai bash agar make nyaman
      }
    }
  },

  // Jalankan go mod tidy otomatis saat container pertama kali dibuka
  "postStartCommand": "cd /app && go mod tidy",

  "remoteUser": "root"
}