# =========================================
# APP CONFIGURATION
# =========================================

# Nama aplikasi
APP_NAME=starter-wahcah-be

# Mode environment: development | staging | production
# - development : SQL log aktif, seeder jalan
# - staging     : SQL log mati, seeder jalan
# - production  : SQL log mati, seeder tidak jalan
APP_ENV=development

# Port yang dijalankan aplikasi (sesuaikan dengan expose di Dockerfile)
APP_PORT=8080

# Origins yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
# Contoh production : https://yourdomain.com,https://app.yourdomain.com
# Contoh development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000


# =========================================
# DATABASE CONFIGURATION
# =========================================

# Host database
# - Docker    : nama service di docker-compose (contoh: db)
# - Lokal     : localhost
# - Remote    : IP atau domain server database
DB_HOST=db

# Port database (MySQL default: 3306)
DB_PORT=3306

# Username database
DB_USER=starter_user

# Password database
DB_PASSWORD=starter_pass

# Nama database
DB_NAME=starter_db


# =========================================
# SECURITY
# =========================================

# Secret key untuk signing JWT token
# - Gunakan string acak yang panjang dan kompleks di production
# - Contoh generate: openssl rand -base64 32
JWT_SECRET=change_this_secret_in_prod

# Durasi expired JWT token
# - Format: angka + satuan (s=detik, m=menit, h=jam, d=hari)
# - Contoh: 15m, 1h, 24h, 7d
JWT_EXPIRES_IN=24h