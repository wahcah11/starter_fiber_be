  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token — otomatis terisi setelah login berhasil"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:9090/health",
              "host": ["http://localhost:9090"],
              "path": ["health"]
            },
            "description": "Cek apakah server berjalan"
          },
          "response": []
        }
      ]
    },
