    {
      "name": "Roles",
      "description": "CRUD Roles — semua endpoint membutuhkan JWT token dengan permission yang sesuai.\nLogin sebagai Superadmin terlebih dahulu untuk mendapatkan akses penuh.",
      "item": [
        {
          "name": "Get All Roles — Sukses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/roles?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["roles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Ambil semua role dengan pagination.\nPermission: role:read\nQuery params: page (default 1), limit (default 10, max 100)"
          },
          "response": []
        },
