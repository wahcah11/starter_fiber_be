    {
      "name": "Roles",
      "description": "Login sebagai Superadmin terlebih dahulu.\nPermission yang dibutuhkan: role:read, role:create, role:update, role:delete",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/roles?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["roles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Role By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
