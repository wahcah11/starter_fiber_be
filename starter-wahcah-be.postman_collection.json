              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"editor-updated\",\n  \"system_function\": \"edit_access_v2\",\n  \"is_default\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/roles/4",
              "host": ["{{baseUrl}}"],
              "path": ["roles", "4"]
            },
            "description": "Ganti angka 4 dengan ID role yang ingin diupdate."
          },
          "response": []
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
